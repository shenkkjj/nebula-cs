# Local gateway image. The Render Dockerfile stays on the old lite path.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LITE_MODE=0 \
    PORTAL_HOST=0.0.0.0 \
    PORTAL_PORT=8080 \
    DATA_DIR=/data

WORKDIR /app

COPY server ./server
COPY web ./web
COPY sample-kb ./sample-kb
COPY tests/eval ./tests/eval
COPY docs ./docs
COPY dify ./dify
COPY results ./results

EXPOSE 8080

# Inside the container the process must listen on 0.0.0.0.
# docker-compose publishes it only on 127.0.0.1 of the host.
CMD ["python3", "server/proxy.py"]
