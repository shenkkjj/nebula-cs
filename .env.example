# Copy to .env and fill in. Never commit .env.
# DeepSeek key belongs in the Dify model settings, not in the browser.
# DIFY_APP_API_KEY is the Chatflow app key (app-...).
DIFY_APP_API_KEY=
DEEPSEEK_API_KEY=
DIFY_CHAT_URL=http://127.0.0.1/v1/chat-messages

# Optional. Needed to list, upload, delete, and write back documents.
# Without these, the gateway can still probe through the chat API.
DIFY_DATASET_API_KEY=
DIFY_DATASET_ID=

# Host Ollama. The gateway only checks it; bge-m3 runs inside Dify's embedding setting.
OLLAMA_HOST=http://127.0.0.1:11434

# SQLite directory. Not committed.
DATA_DIR=./data
