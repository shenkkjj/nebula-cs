# Copy to .env and fill in. Never commit .env.
# Default: Qingdao University of Technology public guides (unofficial assistant).

ENGINE=campus
CAMPUS_PROFILE=qut

# Optional. DeepSeek interprets follow-ups and selects facts from public presets.
# Without a model key the assistant still answers known questions from SQLite.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Optional OpenAI-compatible embeddings. Leave blank to keep lexical BM25 only.
# When all three are set, vectors are stored in embedded Chroma at DATA_DIR/chroma.
# That is an in-process library, not a Chroma server. The built-in ONNX embedder
# stays off; it is too heavy for a 2 GiB host.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# SQLite directory. Not committed.
DATA_DIR=./data

# Only read when ENGINE=dify. The campus engine ignores these.
DIFY_APP_API_KEY=
DIFY_CHAT_URL=http://127.0.0.1/v1/chat-messages
DIFY_DATASET_API_KEY=
DIFY_DATASET_ID=
